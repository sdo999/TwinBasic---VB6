    Private Sub txtWidth_Change()
        If m_loading Then Exit Sub
        If Not optManual.Value Then
            optManual.Value = True      ' fires optManual_Click -> DoRender
        Else
            DoRender
        End If
    End Sub
    
    Private Sub txtHeight_Change()
        If m_loading Then Exit Sub
        If Not optManual.Value Then
            optManual.Value = True
        Else
            DoRender
        End If
    End Sub
    
